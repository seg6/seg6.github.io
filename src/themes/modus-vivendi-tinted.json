{
  "name": "Modus Vivendi Tinted",
  "type": "dark",
  "colors": {
    "editor.background": "#22231f",
    "editor.foreground": "#e9e7df"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#d58f8b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#79add0"
      }
    },
    {
      "name": "String escape",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#afa4d1"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#afa4d1"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "#e9e7df"
      }
    },
    {
      "name": "Boolean",
      "scope": "constant.language.boolean",
      "settings": {
        "foreground": "#afa4d1"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeid",
        "keyword.operator.logical",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#91acd2"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.ternary"
      ],
      "settings": {
        "foreground": "#e9e7df"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#91acd2"
      }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": {
        "foreground": "#78ba86"
      }
    },
    {
      "name": "Storage type namespace (C/C++)",
      "scope": [
        "storage.type.namespace.directive.cpp",
        "storage.type.namespace.definition.cpp"
      ],
      "settings": {
        "foreground": "#91acd2"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.type-parameter",
        "support.type",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#78ba86"
      }
    },
    {
      "name": "Type parameter",
      "scope": "entity.name.type.parameter",
      "settings": {
        "foreground": "#78ba86"
      }
    },
    {
      "name": "Function name",
      "scope": [
        "entity.name.function",
        "entity.name.function.member",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#d59bc8"
      }
    },
    {
      "name": "Method",
      "scope": [
        "entity.name.function.method",
        "meta.method.identifier entity.name.function"
      ],
      "settings": {
        "foreground": "#d59bc8"
      }
    },
    {
      "name": "Function parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#78bdbb"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.object.access.cpp"
      ],
      "settings": {
        "foreground": "#78bdbb"
      }
    },
    {
      "name": "Variable property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#78bdbb"
      }
    },
    {
      "name": "Variable language (this/self)",
      "scope": "variable.language",
      "settings": {
        "foreground": "#91acd2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Class",
      "scope": [
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#78ba86"
      }
    },
    {
      "name": "Namespace / scope qualifier",
      "scope": [
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#afa4d1"
      }
    },
    {
      "name": "Built-in",
      "scope": [
        "support.function.builtin",
        "support.variable",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#d7a7bc"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "meta.decorator entity.name.function",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#afa4d1"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "keyword.control.directive",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#afa4d1"
      }
    },
    {
      "name": "Preprocessor punctuation (# in C/C++)",
      "scope": [
        "punctuation.definition.directive",
        "punctuation.definition.directive.c",
        "punctuation.definition.directive.cpp"
      ],
      "settings": {
        "foreground": "#afa4d1"
      }
    },
    {
      "name": "Include path (C/C++ angle brackets)",
      "scope": [
        "string.quoted.other.lt-gt.include",
        "string.quoted.other.lt-gt.include.c",
        "string.quoted.other.lt-gt.include.cpp"
      ],
      "settings": {
        "foreground": "#79add0"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#e9e7df"
      }
    },
    {
      "name": "String punctuation (quotes, angle brackets in includes)",
      "scope": "punctuation.definition.string",
      "settings": {
        "foreground": "#79add0"
      }
    },
    {
      "name": "Bracket",
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.section",
        "punctuation.definition.begin",
        "punctuation.definition.end"
      ],
      "settings": {
        "foreground": "#e9e7df"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#91acd2"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#78bdbb"
      }
    },
    {
      "name": "CSS property",
      "scope": "support.type.property-name.css",
      "settings": {
        "foreground": "#78bdbb"
      }
    },
    {
      "name": "CSS value",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.font-name",
        "meta.property-value"
      ],
      "settings": {
        "foreground": "#afa4d1"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#d59bc8"
      }
    },
    {
      "name": "CSS unit",
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "#e9e7df"
      }
    },
    {
      "name": "JSON key",
      "scope": "support.type.property-name.json",
      "settings": {
        "foreground": "#78bdbb"
      }
    },
    {
      "name": "YAML key",
      "scope": "entity.name.tag.yaml",
      "settings": {
        "foreground": "#78bdbb"
      }
    },
    {
      "name": "TOML key",
      "scope": "support.type.property-name.toml",
      "settings": {
        "foreground": "#78bdbb"
      }
    },
    {
      "name": "TOML table",
      "scope": "support.type.property-name.table.toml",
      "settings": {
        "foreground": "#78ba86"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "heading.1.markdown",
        "heading.2.markdown",
        "heading.3.markdown",
        "heading.4.markdown",
        "heading.5.markdown",
        "heading.6.markdown",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#e9e7df",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#e9e7df",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#e9e7df",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#82c2a5"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#91acd2"
      }
    },
    {
      "name": "Markdown list marker",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list"
      ],
      "settings": {
        "foreground": "#999a92"
      }
    },
    {
      "name": "Markdown quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#999a92",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Shell variable",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "variable.other.positional.shell"
      ],
      "settings": {
        "foreground": "#78bdbb"
      }
    },
    {
      "name": "Regex group",
      "scope": [
        "string.regexp.group",
        "punctuation.definition.group.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#afa4d1"
      }
    },
    {
      "name": "Regex escape",
      "scope": [
        "constant.other.character-class.regexp",
        "constant.character.escape.backslash.regexp"
      ],
      "settings": {
        "foreground": "#d59bc8"
      }
    },
    {
      "name": "Diff inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#9bc29b"
      }
    },
    {
      "name": "Diff deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#d8aca9"
      }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#c7c17f"
      }
    },
    {
      "name": "Documentation string",
      "scope": [
        "string.quoted.docstring",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#9fbccc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation markup",
      "scope": [
        "comment.block.documentation keyword",
        "comment.block.documentation variable",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#bba6c8"
      }
    },
    {
      "name": "Enum member",
      "scope": "variable.other.enummember",
      "settings": {
        "foreground": "#afa4d1"
      }
    },
    {
      "name": "Label",
      "scope": "entity.name.label",
      "settings": {
        "foreground": "#d7a7bc"
      }
    },
    {
      "name": "Info token",
      "scope": "token.info-token",
      "settings": {
        "foreground": "#78ba86"
      }
    },
    {
      "name": "Warning token",
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#b8a95e"
      }
    },
    {
      "name": "Error token",
      "scope": "token.error-token",
      "settings": {
        "foreground": "#db7e77"
      }
    },
    {
      "name": "Debug token",
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#afa4d1"
      }
    }
  ]
}
