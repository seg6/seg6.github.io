<div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

<script>
  function initProgress() {
    const bar = document.getElementById('reading-progress');
    const prose = document.querySelector<HTMLElement>('.post-prose');
    if (!bar || !prose) return;

    function update() {
      const start = window.scrollY + prose.getBoundingClientRect().top;
      const length = prose.offsetHeight - window.innerHeight;
      const progress = length > 0 ? ((window.scrollY - start) / length) * 100 : 100;
      bar.style.width = `${Math.max(0, Math.min(progress, 100))}%`;
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    window.addEventListener('load', update, { once: true });
    update();
  }

  initProgress();
</script>
