---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Font } from 'astro:assets';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title: string;
  class?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
}

const {
  title,
  class: pageClass,
  description = 'notes on systems, internals, and the occasional hack.',
  image,
  imageAlt,
  type = 'website',
} = Astro.props;
const fullTitle = title === 'seg6' ? 'seg6' : `${title} — seg6`;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImage = image ? new URL(image, siteUrl) : undefined;
---

<!doctype html>
<html lang="en" class={pageClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
    <Font cssVariable="--font-serif" preload={type === 'article' ? [{ weight: 400, style: 'normal' }] : false} />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="seg6 — writing" href="/posts/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="seg6" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt ?? title} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={imageAlt ?? title} />}
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
    <script is:inline>
      try {
        var savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {}
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">skip to content</a>
    <div class="site">
      <Header />
      <div class="content-frame">
        <slot />
      </div>
      <Footer />
    </div>
    <script defer src="https://static.seg6.space/a/s.js" is:inline></script>
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

      function resolvedTheme() {
        const selected = document.documentElement.dataset.theme;
        if (selected === 'light' || selected === 'dark') return selected;
        return systemTheme.matches ? 'dark' : 'light';
      }

      function updateThemeToggle() {
        if (!themeToggle) return;
        const nextTheme = resolvedTheme() === 'dark' ? 'light' : 'dark';
        themeToggle.setAttribute('aria-pressed', String(resolvedTheme() === 'dark'));
        themeToggle.setAttribute('aria-label', `switch to ${nextTheme} theme`);
      }

      themeToggle?.addEventListener('click', () => {
        const nextTheme = resolvedTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        try {
          localStorage.setItem('theme', nextTheme);
        } catch {}
        updateThemeToggle();
        document.dispatchEvent(new CustomEvent('theme:changed', { detail: { theme: nextTheme } }));
      });

      systemTheme.addEventListener('change', () => {
        if (document.documentElement.dataset.theme) return;
        updateThemeToggle();
        document.dispatchEvent(new CustomEvent('theme:changed', { detail: { theme: resolvedTheme() } }));
      });

      updateThemeToggle();
    </script>
  </body>
</html>
