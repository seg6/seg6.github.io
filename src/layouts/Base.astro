---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/stix-two-text/latin-400.css';
import '@fontsource/stix-two-text/latin-400-italic.css';
import '@fontsource/stix-two-text/latin-500.css';
import '@fontsource/stix-two-text/latin-600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  hideFooter?: boolean;
  viewportAxis?: boolean;
  wideContent?: boolean;
}

const {
  title,
  description = 'notes on systems, internals, and the occasional hack.',
  image,
  imageAlt,
  type = 'website',
  hideFooter = false,
  viewportAxis = false,
  wideContent = false,
} = Astro.props;
const fullTitle = title === 'seg6' ? 'seg6' : `${title} — seg6`;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImage = image ? new URL(image, siteUrl) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="seg6" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt ?? title} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={imageAlt ?? title} />}
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
    <script is:inline>
      try {
        var savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {}
    </script>
  </head>
  <body>
    {viewportAxis && <div class="viewport-axis" aria-hidden="true"><span>webview center</span></div>}
    <div class="site">
      <div class="paper-stage" aria-hidden="true">
        <div class="paper-mask">
          <span class="paper-mask-top"></span>
          <span class="paper-mask-right"></span>
          <span class="paper-mask-bottom"></span>
          <span class="paper-mask-left"></span>
        </div>
        <div class="paper-aperture"></div>
      </div>
      <Header />
      <div class:list={['content-frame', { 'content-frame-wide': wideContent }]}>
        <slot />
      </div>
      {!hideFooter && <Footer />}
    </div>
    <script defer src="https://static.seg6.space/a/s.js" is:inline></script>
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

      function resolvedTheme() {
        const selected = document.documentElement.dataset.theme;
        if (selected === 'light' || selected === 'dark') return selected;
        return systemTheme.matches ? 'dark' : 'light';
      }

      function updateThemeToggle() {
        if (!themeToggle) return;
        const nextTheme = resolvedTheme() === 'dark' ? 'light' : 'dark';
        themeToggle.textContent = nextTheme;
        themeToggle.setAttribute('aria-label', `switch to ${nextTheme} theme`);
      }

      themeToggle?.addEventListener('click', () => {
        const nextTheme = resolvedTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        try {
          localStorage.setItem('theme', nextTheme);
        } catch {}
        updateThemeToggle();
        document.dispatchEvent(new CustomEvent('theme:changed', { detail: { theme: nextTheme } }));
      });

      systemTheme.addEventListener('change', () => {
        if (document.documentElement.dataset.theme) return;
        updateThemeToggle();
        document.dispatchEvent(new CustomEvent('theme:changed', { detail: { theme: resolvedTheme() } }));
      });

      updateThemeToggle();
    </script>
  </body>
</html>
