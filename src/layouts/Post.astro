---
import Base from './Base.astro';
import Comments from '../components/Comments.astro';
import TOC from '../components/TOC.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { formatDate } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  date: Date;
  headings: { depth: number; slug: string; text: string }[];
  toc: boolean;
  mermaid?: boolean;
  comments?: boolean;
  readingMinutes: number;
}

const {
  title,
  description,
  image,
  imageAlt,
  date,
  headings,
  toc,
  comments = true,
  readingMinutes,
} = Astro.props;

---

<Base
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
>
  <ReadingProgress />
  <main id="main-content" class="post-page">
    <header class="post-header">
      <a class="post-back" href="/posts/">back to all writing</a>
      <div class="post-meta"><time datetime={date.toISOString()}>{formatDate(date)}</time><span>{readingMinutes} min read</span></div>
      <h1 id="post-title">{title}</h1>
      <p>{description}</p>
    </header>

    <div class="post-body-grid">
      <article class="post-prose" aria-labelledby="post-title">
        <slot />
      </article>
      {toc && <TOC headings={headings} />}
    </div>

    <div class="post-content-wrapper comments-wrapper">
      <div class="post-comments-wrapper">
        <Comments enabled={comments} />
      </div>
    </div>
  </main>

<script>
  async function initMermaid() {
    const nodes = document.querySelectorAll('pre.mermaid');
    if (nodes.length === 0) return;
    const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
    const selected = document.documentElement.dataset.theme;
    const dark = selected ? selected === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
    mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'neutral' });
    nodes.forEach(node => node.removeAttribute('data-processed'));
    await mermaid.run({ nodes });
  }

  function initCodeBlocks() {
    document.querySelectorAll('.post-prose pre').forEach(pre => {
      if (pre.classList.contains('mermaid')) return;
      if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      const code = pre.querySelector('code');
      const lang = (pre as HTMLElement).dataset.language || code?.className?.match(/language-(\w+)/)?.[1];

      if (lang) {
        const label = document.createElement('span');
        label.className = 'code-lang';
        label.textContent = lang;
        wrapper.appendChild(label);
      }

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-btn';
      btn.textContent = 'copy';
      btn.setAttribute('aria-label', 'copy code');
      btn.setAttribute('aria-live', 'polite');
      btn.addEventListener('click', () => {
        const text = code?.textContent || pre.textContent || '';
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = 'copied';
          setTimeout(() => { btn.textContent = 'copy'; }, 1500);
        }).catch(() => {
          btn.textContent = 'could not copy';
          setTimeout(() => { btn.textContent = 'copy'; }, 1500);
        });
      });
      wrapper.appendChild(btn);

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);
    });
  }

  initCodeBlocks();
  initMermaid();
</script>
</Base>
