---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(date: Date) {
  return date.toISOString().slice(0, 10);
}
---

<Base title="posts" description="all posts">
  <main class="index-page">
    <header class="log-header">
      <h1>writing</h1>
      <p>notes on projects, problems, and rabbit holes I fell into while trying to make things work.</p>
      <span class="count">{posts.length} entries</span>
    </header>

    <div class="log-list">
      {posts.map(post => (
        <a href={`/posts/${post.id}/`} class="log-entry">
          <time class="log-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span class="log-title">{post.data.title}</span>
        </a>
      ))}
    </div>
  </main>
</Base>
