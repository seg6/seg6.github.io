---
import Base from '../../layouts/Base.astro';
import Fingerprint from '../../components/Fingerprint.astro';
import { formatMonth, getNumberedPosts, postShape, readingMinutes, shapeLength } from '../../lib/posts';

const posts = await getNumberedPosts();
const longest = Math.max(...posts.map(post => shapeLength(postShape(post.body))));
---

<Base title="writing" description="notes on projects, problems, and rabbit holes I fell into while trying to make things work.">
  <main id="main-content">
    <h1 class="lead">writing</h1>

    <div class="list-tools">
      <div class="legend mono" aria-hidden="true">
        <span><span class="fp"><i></i></span>prose</span>
        <span><span class="fp"><i class="c"></i></span>code</span>
        <span><span class="fp"><i class="i"></i></span>picture</span>
        <span><span class="fp"><i class="h"></i></span>new section</span>
      </div>
    </div>

    <div class="post-rows">
      {posts.map(post => (
        <a href={`/posts/${post.id}/`} class="post-row">
          <span class="post-row-number mono" aria-hidden="true">{post.number}</span>
          <div><h2>{post.data.title}</h2><p>{post.data.description}</p></div>
          <Fingerprint body={post.body} width={380} longest={longest} />
          <span class="post-row-when mono"><time datetime={post.data.date.toISOString()}>{formatMonth(post.data.date)}</time><br />{readingMinutes(post.body)} min</span>
        </a>
      ))}
    </div>
  </main>
</Base>
