---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/posts';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const recent = posts.slice(0, 6);
---

<Base title="seg6" class="home-layout">
  <main id="main-content" class="home-page">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title" class="sr-only">seg6</h1>
      <p>software engineer based in berlin. currently @ meyer sound. notes on systems, internals, and the occasional hack.</p>
      <img src="/img/elma.webp" alt="Elma, a grey cat lying in the sun" width="400" height="400" />
    </section>

    <section class="home-writing" aria-labelledby="latest-writing">
      <div class="section-heading">
        <h2 id="latest-writing">writing</h2>
        <a href="/posts/">all posts ({posts.length})</a>
      </div>
      <div class="home-posts">
        {recent.map(post => (
          <a class="home-post" href={`/posts/${post.id}/`}>
            <h3>{post.data.title}</h3>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
