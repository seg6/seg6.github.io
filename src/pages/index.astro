---
import Base from '../layouts/Base.astro';
import SceneMeta from '../components/SceneMeta.astro';
import { formatMonth, getNumberedPosts } from '../lib/posts';

const posts = await getNumberedPosts();
const recent = posts.slice(0, 5);
---

<Base title="seg6" class="scene-layout" chrome={false}>
  <canvas class="scene" data-scene aria-hidden="true"></canvas>
  <main id="main-content" class="scene-page">
    <div class="scene-id">
      <h1><span class="block">seg6</span></h1>
      <p class="scene-bio"><span class="block">software engineer based in berlin, currently @ meyersound.</span><br /><span class="block">notes on systems, internals, and the occasional hack.</span></p>

      <nav class="scene-nav scene-posts" aria-labelledby="scene-writing">
        <h2 class="scene-label" id="scene-writing"><span class="block">writing</span></h2>
        {recent.map(post => (
          <a href={`/posts/${post.id}/`}><span class="block">{post.data.title}</span><time datetime={post.data.date.toISOString()}>{formatMonth(post.data.date)}</time></a>
        ))}
        <a href="/posts/"><span class="block">all {posts.length} entries →</span></a>
      </nav>

      <nav class="scene-nav" aria-labelledby="scene-more">
        <h2 class="scene-label" id="scene-more"><span class="block">more</span></h2>
        <a href="/projects/"><span class="block">projects →</span></a>
      </nav>
    </div>

    <nav class="scene-links" aria-label="elsewhere">
      <a href="mailto:hi@seg6.space"><span class="block">mail</span></a>
      <a href="https://github.com/seg6"><span class="block">github</span></a>
      <a href="https://x.com/_seg6"><span class="block">x</span></a>
      <a href="/posts/rss.xml"><span class="block">rss</span></a>
    </nav>

    <SceneMeta />
  </main>
</Base>

<script>
  import { initScenePage } from '../scripts/scene-page';

  const boat = ['...1...', '..11...', '.111...', '...1...', '1111111', '.11111.'];

  const narrow = window.matchMedia('(max-width: 44rem)').matches;

  initScenePage({
    horizon: narrow ? 0.33 : 0.64,
    skyline: true,
    sprites: [{ x: 0.42, depth: 0.1, bitmap: boat, phase: 0, speed: 0.0035 }],
  });
</script>
